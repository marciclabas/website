{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "marcelc",
	"compatibility_date": "2026-05-11",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	// No custom domains yet: both environments serve from workers.dev while we
	// develop, so nothing here touches the live marcelc.uk (still on the
	// `website` Pages project). Add `routes` back once the domain is settled.
	"workers_dev": true,
	"preview_urls": true,
	"observability": {
		"logs": {
			"enabled": false,
			"invocation_logs": true
		}
	},
	"env": {
		"dev": {
			"workers_dev": true,
			"preview_urls": true,
			"assets": {
				"binding": "ASSETS",
				"directory": ".svelte-kit/cloudflare"
			}
		}
	}
}
